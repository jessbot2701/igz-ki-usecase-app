// Prisma schema for IGZ AI Use Case Management (SQLite for MVP, swappable to Azure SQL later)
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Role, UseCaseStatus, BusinessValue, Feasibility, Risk, StrategicRelevance are stored as
// validated strings (see src/domain/enums.ts) because SQLite has no native enum type.

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String
  department   String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  createdUseCases     UseCase[]       @relation("CreatedBy")
  modifiedUseCases    UseCase[]       @relation("LastModifiedBy")
  statusChanges       StatusHistory[]
  comments            Comment[]
  evaluations         Evaluation[]
  uploadedAttachments Attachment[]
  emailNotifications EmailNotification[]
  assignedUseCases UseCase[] @relation("AssignedChampion")

  @@map("users")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("departments")
}

model UseCase {
  id    String @id @default(cuid())
  title String

  requestor  String
  department String
  aiChampion String?
  aiChampionId String?
  assignedChampion User? @relation("AssignedChampion", fields: [aiChampionId], references: [id], onDelete: SetNull)

  problemDescription String
  currentProcess     String?
  painPoints         String?
  frequency          String?

  solutionIdea   String
  dataSources    String?
  expectedOutput String?

  targetGroup    String?
  reach          String?
  estimatedUsers Int?
  usageFrequency String?

  benefits             String?
  benefitTypes         String?
  estimatedEffect      String?
  estimatedTimeSavings String?
  businessValueNote    String?
  aiSolutionType       String?
  aiSolutionOtherText  String?
  implementationEffort String?
  dependencies         String?

  dataClassifications String?
  riskAssessment      String?
  securityNotes       String?

  responsible String?
  targetDate  String?

  status String @default("DRAFT")
  clarificationRequestedAt DateTime?
  clarificationAnsweredAt DateTime?

  createdById      String
  createdBy        User   @relation("CreatedBy", fields: [createdById], references: [id])
  lastModifiedById String
  lastModifiedBy   User   @relation("LastModifiedBy", fields: [lastModifiedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory StatusHistory[]
  comments      Comment[]
  evaluations   Evaluation[]
  attachments   Attachment[]
  emailNotifications EmailNotification[]

  @@index([status])
  @@index([department])
  @@index([aiChampionId])
  @@map("use_cases")
}

model StatusHistory {
  id          String   @id @default(cuid())
  useCaseId   String
  useCase     UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  fromStatus  String?
  toStatus    String
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  note        String?
  changedAt   DateTime @default(now())

  @@index([useCaseId])
  @@map("status_history")
}

model Comment {
  id        String   @id @default(cuid())
  useCaseId String
  useCase   UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([useCaseId])
  @@map("comments")
}

model Evaluation {
  id                 String   @id @default(cuid())
  useCaseId          String
  useCase            UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  evaluatorId        String
  evaluator          User     @relation(fields: [evaluatorId], references: [id])
  businessValue      String
  feasibility        String
  risk               String
  strategicRelevance String
  note               String?
  createdAt          DateTime @default(now())

  @@index([useCaseId])
  @@map("evaluations")
}

model Attachment {
  id           String   @id @default(cuid())
  useCaseId    String
  useCase      UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  fileName     String
  storedPath   String
  mimeType     String
  size         Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([useCaseId])
  @@map("attachments")
}

// Only token hashes are stored. Unconfirmed ideas expire with their verification link.
model EmailLoginToken {
  id            String   @id @default(cuid())
  tokenHash     String   @unique
  email         String
  name          String?
  ideaJson      String?
  targetId      String?
  requestIpHash String
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  usedAt        DateTime?

  @@index([email, createdAt])
  @@index([requestIpHash, createdAt])
  @@index([expiresAt])
  @@map("email_login_tokens")
}

// Durable notification queue; failed delivery does not discard a saved comment or status change.
model EmailNotification {
  id            String   @id @default(cuid())
  recipientId   String
  recipient     User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  useCaseId     String
  useCase       UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  kind          String
  createdAt     DateTime @default(now())
  sentAt        DateTime?
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())

  @@index([sentAt, nextAttemptAt])
  @@map("email_notifications")
}
