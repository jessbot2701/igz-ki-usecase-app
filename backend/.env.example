NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
UPLOAD_DIR=uploads
AI_PROVIDER=mock
CORS_ORIGIN=http://localhost:5173

# Employee email access (production: HTTPS URL, allowed domains and SMTP required)
PUBLIC_APP_URL=http://localhost:5173
EMAIL_ALLOWED_DOMAINS=igz.com
MAIL_TRANSPORT=smtp
# Local presentation only; requires MAIL_TRANSPORT=file. Never allowed in production.
DEMO_MODE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Only explicitly trusted reverse proxies; never trust arbitrary forwarded headers.
TRUST_PROXY=
# Local development only: MAIL_TRANSPORT=file saves messages in backend/.local-mail/.
